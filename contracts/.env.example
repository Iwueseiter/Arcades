# Deploy key: sends the deploy transactions (fund it with ~2 CELO). It gets no role in the contracts.
PRIVATE_KEY=0x...
CELO_RPC_URL=https://forno.celo.org
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
# Etherscan API key (one key covers Celo), used to publish the contracts' source
CELOSCAN_API_KEY=

# G$ on Celo mainnet. On the testnet, use the address from `npm run contracts:test-token`.
GD_TOKEN=0x62B8B11039FcfE5aB0C56E502b1C372A3d2a9c7A
# GoodDollar Identity on Celo mainnet (only face-checked people can play tournaments and claim gifts).
# Use 0x0000000000000000000000000000000000000000 on the testnet.
GD_IDENTITY=0xC361A6E67822a0EDc17D899227dd9FC50BD62F42

# Admin of all three contracts: a Safe multisig is safest. Its key can withdraw every G$ in the contracts.
ADMIN=0x...
# Set to true to let ADMIN be a personal wallet on mainnet. Move admin to a Safe later with
# beginDefaultAdminTransfer(safe) on each contract (the Safe accepts after 2 days).
ALLOW_PERSONAL_ADMIN=false
# A team key that can only pause, for emergencies. Optional.
PAUSER=
# Address of the prize-ticket signer (its private key is XURRI_SIGNER_PRIVATE_KEY in the app)
VOUCHER_SIGNER=0x...

# Share of pot boosts and shop sales sent to GoodDollar's UBI pool, in basis points (1000 = 10%, max 5000).
UBI_SHARE_BPS=1000
# Where that share goes. Leave empty: on mainnet it defaults to GoodDollar's UBIScheme, on testnets to nobody.
UBI_RECIPIENT=
