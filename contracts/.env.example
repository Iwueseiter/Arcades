# Deployer key (fund it with a little CELO for gas). Never commit the real .env.
PRIVATE_KEY=0x...
CELO_RPC_URL=https://forno.celo.org
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
# Etherscan API key (one key covers Celo), used to publish the contract source
CELOSCAN_API_KEY=

# GoodDollar G$ on Celo mainnet
GD_TOKEN=0x62B8B11039FcfE5aB0C56E502b1C372A3d2a9c7A
# GoodDollar Identity on Celo mainnet (read from GoodDollar's on-chain NameService).
# Only face-checked GoodDollar users can claim prizes. Use 0x0000000000000000000000000000000000000000 on testnets.
GD_IDENTITY=0xC361A6E67822a0EDc17D899227dd9FC50BD62F42

# Address of the prize signer: the key that signs prize tickets (its private key is XURRI_SIGNER_PRIVATE_KEY in the app)
VOUCHER_SIGNER=0x...
# Where shop revenue goes. Leave unset to recycle it into the reward pool (the contract itself).
TREASURY=
# Final owner. Leave unset to keep the deployer as owner.
OWNER=

# Prize games: optional CELO fee per game in wei (0 = players only pay the network fee), and games per day
PLAY_FEE=0
MAX_PLAYS_PER_DAY=5
