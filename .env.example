# Copy to .env.local for local secrets. NEXT_PUBLIC_* values are baked into the client at build time.

# --- Chain -------------------------------------------------------------------
# 42220 = Celo mainnet, 11142220 = Celo Sepolia testnet
NEXT_PUBLIC_CHAIN_ID=42220
NEXT_PUBLIC_RPC_URL=https://forno.celo.org
# G$ on Celo mainnet. Only override on testnets.
NEXT_PUBLIC_GD_TOKEN_ADDRESS=0x62B8B11039FcfE5aB0C56E502b1C372A3d2a9c7A
# GoodTapArcade address from `forge script script/Deploy.s.sol`.
# Leave empty to run in demo mode (off-chain balance, no wallet needed).
NEXT_PUBLIC_ARCADE_ADDRESS=

# --- Server secrets (never commit) ---------------------------------------------
# Signs session cookies. Generate with: openssl rand -hex 32
GOODTAP_SESSION_SECRET=
# Private key whose address is the contract's VOUCHER_SIGNER. Holds no funds; only signs reward vouchers.
GOODTAP_SIGNER_PRIVATE_KEY=

# --- Game economy (G$) ---------------------------------------------------------
GOODTAP_REWARD_PER_100_POINTS=0.05
GOODTAP_MAX_REWARD_PER_ROUND=1

# --- Database ------------------------------------------------------------------
# SQLite for local dev. For production use a hosted database (change the provider in prisma/schema.prisma).
DATABASE_URL="file:./goodtap.db"
