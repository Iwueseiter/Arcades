# Copy to .env.local for local secrets. NEXT_PUBLIC_* values are baked into the client at build time.

# --- Chain -------------------------------------------------------------------
# 42220 = Celo mainnet, 11142220 = Celo Sepolia testnet
NEXT_PUBLIC_CHAIN_ID=42220
NEXT_PUBLIC_RPC_URL=https://forno.celo.org
# G$ on Celo mainnet. Only override on testnets.
NEXT_PUBLIC_GD_TOKEN_ADDRESS=0x62B8B11039FcfE5aB0C56E502b1C372A3d2a9c7A
# The three contract addresses printed by `npm run contracts:deploy`.
# Leave them empty to run in demo mode (play money, no wallet needed).
NEXT_PUBLIC_GIFT_ADDRESS=
NEXT_PUBLIC_TOURNAMENTS_ADDRESS=
NEXT_PUBLIC_SHOP_ADDRESS=

# --- Server secrets (never commit) ---------------------------------------------
# Signs session cookies. Generate with: openssl rand -hex 32
XURRI_SESSION_SECRET=
# Private key whose address is the contract's VOUCHER_SIGNER. Holds no funds; only signs tournament prize tickets.
XURRI_SIGNER_PRIVATE_KEY=
# Server-only admin login. Use a unique random password with at least 16 characters.
XURRI_ADMIN_EMAIL=
XURRI_ADMIN_PASSWORD=
# Block number of the contract deployment (any block just before it works). The analytics page
# reads the contracts' history from here.
XURRI_DEPLOY_BLOCK=

# Protects the admin review/ban API. Generate with: openssl rand -hex 32
XURRI_ADMIN_SECRET=
# Lets the hourly scheduler hand out tournament prizes (Vercel sends it automatically). openssl rand -hex 32
CRON_SECRET=

# --- Tournament (G$) -------------------------------------------------------------
# Players earn only from daily claims and this weekly tournament. Base prizes per place, first place first;
# G$ boosted into a week's pot raises every place in proportion.
XURRI_TOURNAMENT_PRIZES=50,30,20,10,10,5,5,5,5,5
# Hours after the week ends (Monday 00:00 UTC) before prizes go out, to review the top scores.
XURRI_TOURNAMENT_REVIEW_HOURS=24

# --- Support -------------------------------------------------------------------
# Shown on the Terms and Privacy pages.
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Database ------------------------------------------------------------------
# Postgres. Locally: `docker compose up -d` gives you this one. In production use Neon, Supabase, Railway, etc.
DATABASE_URL="postgresql://xurri:xurri@localhost:5432/xurri"
