# App
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_NAME=GoodTap
NEXT_PUBLIC_DEBUG_MODE=false

# GoodDollar
NEXT_PUBLIC_GOODDOLLAR_CHAIN_ID=42220
NEXT_PUBLIC_GOODDOLLAR_RPC_URL=https://forno.celo.org
NEXT_PUBLIC_GOODDOLLAR_WALLET_ADDRESS=0xF42C9Ca2b10010142e2bAc34eBdDDB0b82177684
NEXT_PUBLIC_GOODDOLLAR_TOKEN_ADDRESS=0x62b8b11039fcfe5ab0c56e502b1c372a3d2a9c7a
NEXT_PUBLIC_GOODDOLLAR_REWARD_POOL_ADDRESS=0xF42C9Ca2b10010142e2bAc34eBdDDB0b82177684
NEXT_PUBLIC_GOODDOLLAR_SHOP_ADDRESS=0xF42C9Ca2b10010142e2bAc34eBdDDB0b82177684
NEXT_PUBLIC_GOODDOLLAR_REFERRAL_ADDRESS=0xF42C9Ca2b10010142e2bAc34eBdDDB0b82177684

# Wallet provider
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id
NEXT_PUBLIC_PUBLIC_RPC_URL=https://forno.celo.org

# Postgres / realtime
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/goodtap
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Security
NEXT_PUBLIC_ENABLE_MOCK_CONTRACTS=false
GOODTAP_RATE_LIMIT_PER_MINUTE=60
GOODTAP_JWT_SECRET=replace_with_strong_secret
