{
  "name": "xurri",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --experimental-require-module ./node_modules/next/dist/bin/next dev",
    "build": "node --experimental-require-module ./node_modules/next/dist/bin/next build",
    "vercel-build": "prisma generate && prisma migrate deploy && node --experimental-require-module ./node_modules/next/dist/bin/next build",
    "start": "node --experimental-require-module ./node_modules/next/dist/bin/next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "contracts:install": "cd contracts && forge install --no-git OpenZeppelin/openzeppelin-contracts@v5.4.0 foundry-rs/forge-std@v1.17.0",
    "contracts:test": "cd contracts && forge test",
    "contracts:test-token": "cd contracts && forge script script/TestToken.s.sol --tc DeployTestToken --rpc-url celo_sepolia --broadcast",
    "contracts:deploy:testnet": "cd contracts && forge script script/Deploy.s.sol --rpc-url celo_sepolia --broadcast",
    "contracts:simulate": "cd contracts && forge script script/Deploy.s.sol --rpc-url celo",
    "contracts:deploy": "cd contracts && forge script script/Deploy.s.sol --rpc-url celo --broadcast --verify",
    "deploy:mainnet": "bash scripts/deploy-mainnet.sh"
  },
  "dependencies": {
    "@magic-ext/connect": "^9.1.0",
    "@magic-sdk/admin": "^2.8.4",
    "@prisma/client": "^6.19.3",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.107.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.9.0",
    "lucide-react": "^1.67.0",
    "magic-sdk": "^33.14.0",
    "next": "^16.4.4",
    "prisma": "^6.19.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.18",
    "wagmi": "^3.7.11",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.5",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.4",
    "globals": "^17.14.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.3.4",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
